# Verified 2026-10-26 on node12 / node17 / node4, 3 x 8 H200.
# Source in each torchrun process's shell. This does not change host networking.
export OMP_NUM_THREADS=2
export OPENBLAS_NUM_THREADS=2
export CUBLAS_WORKSPACE_CONFIG=:4096:8
export PYTORCH_ALLOC_CONF=expandable_segments:True
export NCCL_SOCKET_IFNAME=eth0
export NCCL_IB_GID_INDEX=3
export NCCL_NET_PLUGIN=none
export NCCL_NVLS_ENABLE=0
export NCCL_IB_HCA='=mlx5_0:1,mlx5_1:1,mlx5_2:1,mlx5_3:1,mlx5_4:1,mlx5_5:1,mlx5_6:1,mlx5_7:1'
export NCCL_CROSS_NIC=0
export NCCL_NET_GDR_LEVEL=LOC
export UCX_VFS_ENABLE=n
