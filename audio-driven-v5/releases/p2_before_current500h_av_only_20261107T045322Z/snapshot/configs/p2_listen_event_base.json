{
  "version": "p2-listen-event-v1",
  "reuse_root": "../audio-driven-v4",
  "output": "experiments/p2_listen_event_v1",
  "extractor": {
    "hidden_layers": [8, 18, 28, 35], "layer_fusion": "attention",
    "fusion_width": 512, "fusion_depth": 2, "fusion_heads": 8,
    "vision_fps": 8, "audio_hz": 8, "vision_max_pixels": 50176,
