  "data": {"fps": 25, "size": 512, "max_frames": 201, "min_seconds": 2},
  "events": {"types": ["listener_vocalization", "head_nod"], "weight": 0.05, "head_width": 128, "pos_weight_cap": 10},
  "training": {"global_batch": 8, "steps": 1000, "connector_lr": 0.00003, "feature_lr": 0.00003, "event_lr": 0.0001,
    "warmup_steps": 50, "save_every": 100, "clip_norm": 1, "weight_decay": 0},
  "generation": {"steps": 30, "video_cfg": 3, "audio_cfg": 7, "seeds": [137, 251], "u_in_cfg": "both_branches"}
}
