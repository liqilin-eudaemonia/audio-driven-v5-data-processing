{
  "schema": "glare-public-detector-v1",
  "fps": 25,
  "fer_input": "BGR",
  "face_selection": "exactly_one_fer_face_overlapping_mediapipe",
  "min_face_iou": 0.1,
  "required_frame_coverage": 1.0,
  "nodding_variant": "v2_python_defaults",
  "reaction_parameters": {
    "smiling": {
      "smooth_window": 7,
      "th_on": 0.45,
      "th_off": 0.3,
      "min_event_len": 6
    },
    "laughing": {
      "smooth_window": 9,
      "th_on": 0.52,
      "th_off": 0.36,
      "min_event_len": 8
    },
    "frowning": {
      "smooth_window": 7,
      "th_on": 0.42,
      "th_off": 0.3,
      "min_event_len": 6
    },
    "surprised": {
      "smooth_window": 7,
      "th_on": 0.45,
      "th_off": 0.32,
      "min_event_len": 5
    },
    "nodding": {
      "smooth_window": 9,
      "baseline_window": 45,
      "th_on": 0.58,
      "th_off": 0.42,
      "min_event_len": 10,
      "min_turns_per_event": 2,
      "yaw_penalty_weight": 0.5,
      "min_pitch_peak_to_valley_deg": 3.0,
      "min_peak_pitch_vel_deg": 0.2,
      "min_cycles_per_event": 1
    },
    "head_shaking": {
      "smooth_window": 9,
      "baseline_window": 40,
      "th_on": 0.5,
      "th_off": 0.35,
      "min_event_len": 7,
      "min_turns_per_event": 1,
      "pitch_penalty_weight": 0.4,
      "min_yaw_peak_to_valley_deg": 2.0,
      "min_peak_yaw_vel_deg": 0.12,
      "min_cycles_per_event": 0
    }
  },
  "combination": "framewise_max_ties_column_order",
  "score_threshold": 0.5
}
